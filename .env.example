# Copy to .env and fill in the keys for providers you want.
# The agent auto-picks the first provider whose key is present
# (or use --provider to choose explicitly).

# BigModel / Zhipu GLM  (https://open.bigmodel.cn)
BIGMODEL_API_KEY=

# OpenRouter — one key, hundreds of models (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# NVIDIA NIM (https://build.nvidia.com, key starts with nvapi-)
NVIDIA_API_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
